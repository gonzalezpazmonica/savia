{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "SKILLS.md",
    "CLAUDE.md",
    ".claude/profiles/savia.md",
    ".claude/profiles/active-user.md",
    "docs/rules/domain/radical-honesty.md",
    "docs/rules/domain/autonomous-safety.md",
    "docs/rules/domain/caveman-default.md",
    "docs/rules/domain/agents-catalog.md",
    ".claude/CONSTITUCION.md"
  ],
  "plugin": [
    "opencode-sandbox"
  ],
  "experimental": {
    "sandbox": {
      "policy_dir": ".opencode/sandbox-policies",
      "default_policy": "default-readonly",
      "fail_if_unavailable": false,
      "enabled": false
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "permission": {
        "edit": "allow",
        "task": "allow",
        "webfetch": "allow",
        "bash": {
          "rm -rf *": "deny",
          "rm -rf /*": "deny",
          "chmod 777 *": "deny",
          "chmod -R 777 *": "deny",
          "curl * | sh": "deny",
          "curl * | bash": "deny",
          "wget * | sh": "deny",
          "wget * | bash": "deny",
          "git push --force *": "ask",
          "git push -f *": "ask",
          "git reset --hard *": "ask",
          "git clean -fd *": "ask",
          "git *": "allow",
          "gh *": "allow",
          "dotnet *": "allow",
          "npm *": "allow",
          "python3 *": "allow",
          "pytest *": "allow",
          "bats *": "allow",
          "bash *": "allow",
          "*": "allow"
        }
      },
      "model_tier": "fast"
    },
    "plan": {
      "mode": "primary",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "task": "deny"
      },
      "model_tier": "fast"
    },
    "code-reviewer": {
      "description": "Revisión de código .NET como quality gate antes de merge. Focus: SOLID, OWASP, performance.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git log*": "allow",
          "grep *": "allow",
          "dotnet build": "allow",
          "dotnet test*": "allow"
        }
      },
      "temperature": 0.1
    },
    "architect": {
      "description": "Diseño de arquitectura .NET y decisiones técnicas de alto nivel. SOLID, DDD, Clean Architecture.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git *": "allow",
          "grep *": "allow",
          "dotnet *": "allow",
          "npm *": "allow"
        }
      }
    },
    "security-guardian": {
      "description": "Auditor de seguridad pre-commit. Detecta credenciales, OWASP, CWE Top 25, datos sensibles.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git *": "allow",
          "grep *": "allow"
        }
      }
    },
    "business-analyst": {
      "description": "Análisis de reglas de negocio, descomposición de PBIs, criterios de aceptación.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "test-runner": {
      "description": "Ejecuta suite completa de tests y verifica cobertura >= 80%.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "dotnet test*": "allow",
          "npm test*": "allow",
          "npm run test*": "allow",
          "pytest*": "allow",
          "go test*": "allow"
        }
      }
    },
    "commit-guardian": {
      "description": "Verifica cambios staged antes de commit: branch, tests, formato, credenciales.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git *": "allow",
          "grep *": "allow"
        }
      }
    },
    "typescript-developer": {
      "description": "Implementacion TypeScript/Node.js siguiendo specs SDD.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "npm *": "allow",
          "npx *": "allow",
          "node *": "allow",
          "tsc *": "allow",
          "vitest *": "allow",
          "git *": "allow",
          "grep *": "allow",
          "*": "deny"
        }
      }
    },
    "infrastructure-agent": {
      "description": "Infraestructura cloud, contenedores, scripts bash.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow"
        }
      }
    },
    "dotnet-developer": {
      "description": "Implementacion C#/.NET siguiendo specs SDD.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "dotnet *": "allow",
          "npm *": "allow",
          "git *": "allow",
          "grep *": "allow",
          "*": "deny"
        }
      }
    },
    "frontend-developer": {
      "description": "Implementacion frontend Angular/React siguiendo specs SDD.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "npm *": "allow",
          "npx *": "allow",
          "ng *": "allow",
          "git *": "allow",
          "grep *": "allow",
          "*": "deny"
        }
      }
    },
    "python-developer": {
      "description": "Implementacion Python/FastAPI/Django siguiendo specs SDD.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "python *": "allow",
          "pip *": "allow",
          "pytest *": "allow",
          "npm *": "allow",
          "git *": "allow",
          "grep *": "allow",
          "*": "deny"
        }
      }
    },
    "sdd-spec-writer": {
      "description": "Generacion y validacion de specs SDD como contratos ejecutables.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "git *": "allow",
          "grep *": "allow",
          "*": "deny"
        }
      }
    },
    "dev-orchestrator": {
      "description": "Analiza specs y crea planes de implementacion con slices.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "deny"
      }
    },
    "explore": {
      "description": "Fast agent for exploring codebases.",
      "mode": "subagent",
      "permission": {
        "edit": "deny",
        "write": "deny",
        "bash": "deny"
      },
      "model_tier": "fast"
    },
    "general": {
      "description": "General-purpose agent for complex multi-step tasks.",
      "mode": "subagent",
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": {
          "*": "allow"
        }
      },
      "model_tier": "fast"
    }
  },
  "command": {
    "sprint-status": {
      "template": "Estado del sprint actual. Obtén el sprint activo, calcula progreso, burndown y alertas de WIP. Usa la skill sprint-management. Carga el perfil activo para personalizar output.",
      "description": "Estado del sprint — progreso, burndown, alertas",
      "agent": "build"
    },
    "board-flow": {
      "template": "Flujo del board — WIP por columna, aging, throughput, bloqueos. Analiza cuellos de botella y sugiere acciones.",
      "description": "Board flow — WIP, aging, throughput",
      "agent": "build"
    },
    "my-sprint": {
      "template": "Items del sprint actual asignados al usuario activo. Muestra estado, remaining work, bloqueos.",
      "description": "My sprint — items del usuario activo",
      "agent": "build"
    },
    "daily-routine": {
      "template": "Rutina diaria: daily standup, revisión de bloqueos, plan del día. Hora target: 09:15.",
      "description": "Daily routine — standup y plan del día",
      "agent": "build"
    },
    "compact": {
      "template": "Libera contexto compactando la sesión actual. Resume lo esencial y libera memoria.",
      "description": "Compact — liberar contexto",
      "agent": "build"
    },
    "my-focus": {
      "template": "Item prioritario del usuario activo. Muestra estado, bloqueos, dependencias y siguiente paso.",
      "description": "Focus — item prioritario del usuario",
      "agent": "build"
    },
    "savia-live": {
      "template": "Savia live — estado actual del workspace: salud de agentes, hooks activos, memoria, sprint activo.",
      "description": "Savia live — estado actual del workspace",
      "agent": "build"
    },
    "help": {
      "template": "Catálogo de comandos y agentes disponibles en pm-workspace. Agrupados por categoría.",
      "description": "Help — catálogo de comandos",
      "agent": "build"
    },
    "savia-shield": {
      "template": "Gestión de Savia Shield. Argumentos: $ARGUMENTS. Por defecto 'status' si está vacío.\n\n- Si es 'status' o vacío: ejecuta `bash scripts/savia-shield-status.sh` y muestra el resultado. Si el script falla, determina manualmente: leer `.claude/settings.local.json` para SAVIA_SHIELD_ENABLED, curl a daemon (8444/health) y Ollama (11434/api/tags), y verificar hooks en `.opencode/hooks/`.\n- Si es 'enable': leer `.claude/settings.local.json`, poner env.SAVIA_SHIELD_ENABLED a \"true\", guardar, responder \"✅ Savia Shield activado.\"\n- Si es 'disable': leer `.claude/settings.local.json`, poner env.SAVIA_SHIELD_ENABLED a \"false\", guardar, responder \"⛔ Savia Shield desactivado.\"",
      "description": "Savia Shield — estado, activar, desactivar",
      "agent": "build"
    }
  },
  "autoupdate": false,
  "snapshot": true,
  "share": "manual",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "env",
        "PATH=/home/monica/.nvm/versions/node/v22.23.2/bin:/usr/bin:/bin",
        "/home/monica/.nvm/versions/node/v22.23.2/bin/codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "/home/monica/.local/bin/codebase-memory-mcp",
        "serve"
      ],
      "enabled": true,
      "timeout": 60000
    },
    "savia-vaults": {
      "type": "local",
      "command": [
        "/home/monica/.nvm/versions/node/v22.23.2/bin/node",
        "projects/savia-vaults/dist/cli/index.js",
        "serve",
        "--transport",
        "mcp",
        "--domes",
        "projects/savia-vaults/savia-vaults.domes.json"
      ],
      "enabled": true,
      "timeout": 60000
    }
  }
}
