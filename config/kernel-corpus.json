  "not_verified": [
    {"category": "mcp", "reason": "requiere servidores MCP vivos; fuera del simulador determinista"},
    {"category": "runtime_adapter", "reason": "requiere ejecutar OpenCode/Codex; F7 projections"},
    {"category": "receipt", "reason": "los receipts de efectos de runtime no tienen productor determinista en el árbol"},
