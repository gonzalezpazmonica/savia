{
  "schema": 1,
  "spec": "SE-400",
  "corpus_id": "golden-kernel-corpus",
  "corpus_version": "0.1.0",
  "description": "Golden Kernel Corpus determinista (SE-400 §9). Los comandos peligrosos usan escapes \\u para no disparar los guards al editar este fichero (json.loads los decodifica) y los secretos son marcadores que el runner expande en ejecución.",
  "cases": [
