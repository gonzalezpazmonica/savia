    {"id": "search-grep", "category": "discovery_context", "type": "event", "event": "PreToolUse",
     "tool": "Grep", "input": {"pattern": "Human Gate", "path": "docs"}, "expect": "ALLOW"},
    {"id": "governed-write-doc", "category": "governed_write", "type": "event", "event": "PreToolUse",
