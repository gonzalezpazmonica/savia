{
  "schema": 1,
  "_doc": "SE-493 — registro de operaciones del Effect Ledger. Cada op declara clase, sonda, campos, plazos y limitaciones. Una op non_idempotent sin sonda previa invalida el registro entero (Regla 7b).",
  "ops": {
    "pr.merge": {
      "effect_class": "non_idempotent",
      "key": "{repo}#{number}",
      "args": {
        "repo": "repo",
        "number": "pr_number",
        "head": "sha40",
        "method": {"enum": ["merge", "squash", "rebase"]}
      },
      "observable": ["repo", "number", "head"],
      "unverified": ["method"],
      "head_pinned": true,
      "probe": "gh_pr_merge",
      "probe_fields": ["state", "mergedAt", "mergeCommit", "mergedBy", "headRefOid", "autoMergeRequest"],
      "pre_probe": true,
      "identity_cmd": ["gh", "api", "user", "--jq", ".login"],
      "response_evidence": "mergeCommit",
      "request_timeout_s": 120,
      "dispatch_grace_s": 300,
      "lease_s": 600,
      "remote_double_exec_protection": "gh pr merge --match-head-commit; un PR mergeado no se mergea dos veces",
      "merge_queue": "unsupported"
    }
  }
}
