#!/usr/bin/env bash
# Git pre-commit hook — privacidad de proyectos y compliance de reglas.
# Se ejecuta ANTES de cada commit, independientemente de Savia o Claude Code.
#
# Instalación: git config core.hooksPath .githooks (compartido por todos los worktrees del repo).
#
# Lo ejecuta git en el repo real del commit, con lo que de verdad va en stage. Funciona igual con
# git -C, cd, subshell, heredoc, script o commit -a. Se puede esquivar (--no-verify, otro core.hooksPath):
# la autoridad de merge es la CI, paso «Compliance runner» del job obligatorio «Validate workspace», con el
# mismo runner sobre el diff de la PR. Ese runner sale del árbol de la PR: un cambio en .claude/compliance/
# o .githooks/ exige revisión humana explícita (CODEOWNERS).

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
rc=0

# 0. Nunca commit en main/master (autonomous-safety). Complementa block-commit-to-main.sh, que analiza el
# texto de la orden y no ve un script escrito y ejecutado en la misma orden ni git invocado con otro nombre.
# Aquí decide git: la rama del repo del commit. HEAD separado (rebase, bisect) se permite. Si la rama no se
# puede leer por otro motivo, se bloquea (fail-closed). Bypass consciente y registrado: SAVIA_ALLOW_MAIN_COMMIT=1.
BRANCH="$(git symbolic-ref --short -q HEAD)"; ref_rc=$?
if [ "$ref_rc" -ne 0 ] && [ "$ref_rc" -ne 1 ]; then
    echo "🛑 RAMA: no se pudo leer la rama actual en $ROOT (git symbolic-ref salió con $ref_rc). Commit bloqueado." >&2
    exit 1
fi
if [ "$ref_rc" -eq 0 ] && { [ "$BRANCH" = "main" ] || [ "$BRANCH" = "master" ]; }; then
    LOG_DIR="${SAVIA_TURN_SDLC_LOG_DIR:-$ROOT/output/turn-sdlc}"
    if [ "${SAVIA_ALLOW_MAIN_COMMIT:-0}" = "1" ]; then
        verdict=bypass
    else
        verdict=block
    fi
    mkdir -p "$LOG_DIR" 2>/dev/null
    printf '{"ts":"%s","branch":"%s","action":"commit","verdict":"%s","source":"githook"%s}\n' \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$BRANCH" "$verdict" \
        "$([ "$verdict" = bypass ] && printf ',"env":"SAVIA_ALLOW_MAIN_COMMIT=1"')" \
        >> "$LOG_DIR/commit-guard.jsonl" 2>/dev/null \
        || echo "⚠️  RAMA: no se pudo registrar en $LOG_DIR/commit-guard.jsonl" >&2
    if [ "$verdict" = block ]; then
        echo "🛑 RAMA: commit en $BRANCH bloqueado (autonomous-safety: nunca commit en main/master)." >&2
        echo "   Crea una rama propia y commitea ahí: git switch -c agent/<tarea>" >&2
        echo "   Si eres la operadora y el commit en $BRANCH es intencional: SAVIA_ALLOW_MAIN_COMMIT=1 git commit ... (queda registrado)." >&2
        exit 1
    fi
fi

# 1. Privacidad de proyectos
if [ -f "$ROOT/scripts/protect-project-privacy.sh" ]; then
    bash "$ROOT/scripts/protect-project-privacy.sh" --hook || rc=1
fi

# 2. Compliance de reglas sobre lo que va en stage, en este repo (no el de la sesión)
if [ -f "$ROOT/.claude/compliance/runner.sh" ]; then
    if ! (cd "$ROOT" && env -u CLAUDE_PROJECT_DIR bash .claude/compliance/runner.sh --staged); then
        echo "" >&2
        echo "🛑 COMPLIANCE: commit bloqueado por violación de reglas en $ROOT." >&2
        echo "   Diagnóstico completo: bash .claude/compliance/runner.sh --all" >&2
        rc=1
    fi
fi

exit $rc
