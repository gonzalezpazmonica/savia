{
  "category": "runtime",
  "compat": {
    "min_runtime_version": "1.0"
  },
  "conflicts": [
    "opencode-legacy"
  ],
  "depends_on": [
    "node",
    "savia-core"
  ],
  "id": "opencode",
  "license": "MIT",
  "schema_version": 1,
  "targets": [
    {
      "actions": {
        "install": {
          "changes": [
            {
              "kind": "path",
              "target": "~/.npm-global/bin"
            }
          ],
          "invocation": {
            "args": [
              "install",
              "-g",
              "opencode-ai"
            ],
            "executable": "npm"
          },
          "privilege": "USER",
          "reversibility": "reversible"
        },
        "uninstall": {
          "changes": [
            {
              "kind": "path",
              "target": "~/.npm-global/bin"
            }
          ],
          "invocation": {
            "args": [
              "install",
              "-g",
              "opencode-ai"
            ],
            "executable": "npm"
          },
          "privilege": "USER",
          "reversibility": "reversible"
        },
        "verify": {
          "invocation": {
            "args": [
              "--version"
            ],
            "executable": "opencode"
          },
          "privilege": "USER",
          "reversibility": "reversible"
        }
      },
      "arch": [
        "x64"
      ],
      "os": "linux",
      "source": {
        "kind": "package_manager",
        "locator": "npm:opencode-ai"
      }
    },
    {
      "actions": {
        "install": {
          "invocation": {
            "args": [
              "install",
              "-g",
              "opencode-ai"
            ],
            "executable": "npm"
          },
          "privilege": "USER",
          "reversibility": "reversible"
        },
        "uninstall": {
          "invocation": {
            "args": [
              "install",
              "-g",
              "opencode-ai"
            ],
            "executable": "npm"
          },
          "privilege": "USER",
          "reversibility": "reversible"
        },
        "verify": {
          "invocation": {
            "args": [
              "--version"
            ],
            "executable": "opencode"
          },
          "privilege": "USER",
          "reversibility": "reversible"
        }
      },
      "arch": [
        "x64"
      ],
      "os": "windows",
      "source": {
        "kind": "package_manager",
        "locator": "npm:opencode-ai"
      }
    }
  ],
  "version": "1.2"
}
