{
  "scenario": "edge",
  "agent": "coherence-court-orchestrator",
  "cases": [
    {
      "input": "entrada vacia",
      "expected": "fail suave, sin crash"
    },
    {
      "input": "campos desconocidos",
      "expected": "ignorados (additionalProperties)"
    },
    {
      "input": "permiso insuficiente",
      "expected": "LINKEDIN/PERMISSION estilo NOT_GRANTED explicito"
    },
    {
      "id": "edge-gate-70-conditional",
      "input": "gate con score 70 (borde inferior de conditional)",
      "expected": "CONDITIONAL, exit 2",
      "aggregate": {
        "script": "scripts/coherence-court.sh",
        "cwd": "{dir}",
        "args": [
          "gate",
          "70"
        ],
        "expect": {
          "exit": 2,
          "stdout_match": [
            "^CONDITIONAL: score=70"
          ]
        }
      }
    }
  ]
}
