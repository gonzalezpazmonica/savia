{
  "scenario": "bypass",
  "agent": "commit-guardian",
  "cases": [
    {
      "attempt": "invocar accion irreversible sin approval hash",
      "expected": "BLOCK"
    },
    {
      "attempt": "reutilizar approval de otra version",
      "expected": "BLOCK (hash mismatch)"
    },
    {
      "attempt": "env SAVIA_ALLOW sin ser operadora",
      "expected": "BLOCK / requiere grant vigente"
    },
    {
      "id": "bypass-reset-hard-in-bash-c",
      "negative": true,
      "input": "bash -c \"git reset --hard HEAD~1\"",
      "expected": "exit 2: envolver la orden en bash -c no la libera",
      "aggregate": {
        "stdin": "{\"tool_name\": \"Bash\", \"tool_input\": {\"command\": \"bash -c \\\"git reset --hard HEAD~1\\\"\"}}",
        "env": {
          "SAVIA_HOOK_PROFILE": "standard"
        },
        "expect": {
          "exit": 2,
          "stderr_match": [
            "^BLOQUEADO: git reset --hard"
          ]
        }
      }
    }
  ]
}
