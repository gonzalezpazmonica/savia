{
  "scenario": "golden",
  "agent": "commit-guardian",
  "input": {
    "task": "ejecutar funcion principal segun spec del agente"
  },
  "expected": {
    "behavior": "segun descriptor agent.commit-guardian",
    "laws_linked": true,
    "human_gate_respected": true
  },
  "assertions": [
    "descriptor existe",
    "laws aplicables enlazadas",
    "enforcement activo"
  ],
  "cases": [
    {
      "id": "golden-feature-push-allowed",
      "input": "git push origin agent/test-x",
      "expected": "exit 0: push a rama propia permitido",
      "aggregate": {
        "script": ".claude/hooks/block-force-push.sh",
        "cwd": "{dir}",
        "stdin": "{\"tool_name\": \"Bash\", \"tool_input\": {\"command\": \"git push origin agent/test-x\"}}",
        "env": {
          "SAVIA_HOOK_PROFILE": "standard"
        },
        "expect": {
          "exit": 0,
          "stderr_not_match": ["BLOQUEADO"],
          "stdout_empty": true
        }
      }
    },
    {
      "id": "golden-force-push-blocked",
      "negative": true,
      "input": "git push --force origin agent/test-x",
      "expected": "exit 2 BLOQUEADO",
      "aggregate": {
        "script": ".claude/hooks/block-force-push.sh",
        "cwd": "{dir}",
        "stdin": "{\"tool_name\": \"Bash\", \"tool_input\": {\"command\": \"git push --force origin agent/test-x\"}}",
        "env": {
          "SAVIA_HOOK_PROFILE": "standard"
        },
        "expect": {
          "exit": 2,
          "stderr_match": [
            "^BLOQUEADO: git push --force"
          ]
        }
      }
    }
  ]
}
