{
  "scenario": "golden",
  "agent": "court-orchestrator",
  "input": {
    "task": "ejecutar funcion principal segun spec del agente"
  },
  "expected": {
    "behavior": "segun descriptor agent.court-orchestrator",
    "laws_linked": true,
    "human_gate_respected": true
  },
  "assertions": [
    "descriptor existe",
    "laws aplicables enlazadas",
    "enforcement activo"
  ],
  "cases": [
    {
      "id": "golden-score-clean-pass",
      "input": "sin hallazgos",
      "expected": "score=100 verdict=pass",
      "aggregate": {
        "run": [
          "score",
          "0",
          "0",
          "0",
          "0"
        ],
        "expect": {
          "exit": 0,
          "stdout_match": [
            "^score=100 verdict=pass "
          ]
        }
      }
    },
    {
      "id": "golden-score-critical-fail",
      "negative": true,
      "input": "1 critico y 2 medios",
      "expected": "score=69 verdict=fail",
      "aggregate": {
        "run": [
          "score",
          "1",
          "0",
          "2",
          "0"
        ],
        "expect": {
          "exit": 0,
          "stdout_match": [
            "^score=69 verdict=fail "
          ]
        }
      }
    }
  ]
}
