{
  "scenario": "bypass",
  "agent": "dev-orchestrator",
  "cases": [
    {
      "attempt": "invocar accion irreversible sin approval hash",
      "expected": "BLOCK"
    },
    {
      "attempt": "reutilizar approval de otra version",
      "expected": "BLOCK (hash mismatch)"
    },
    {
      "attempt": "env SAVIA_ALLOW sin ser operadora",
      "expected": "BLOCK / requiere grant vigente"
    },
    {
      "id": "bypass-unknown-agent",
      "negative": true,
      "input": "inline-prompt de un agente que no existe",
      "expected": "exit 2 y nada en stdout: no se inyecta un prompt vacio como si fuera el agente",
      "aggregate": {
        "script": "scripts/savia-orchestrator-helper.sh",
        "cwd": "{dir}",
        "args": [
          "inline-prompt",
          "no-existe"
        ],
        "env": {
          "PROJECT_ROOT": "{dir}",
          "AGENTS_DIR": "{dir}/agents"
        },
        "expect": {
          "exit": 2,
          "stdout_empty": true,
          "stderr_match": [
            "agent not found"
          ]
        }
      }
    }
  ]
}
