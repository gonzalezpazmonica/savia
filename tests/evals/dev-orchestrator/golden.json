{
  "scenario": "golden",
  "agent": "dev-orchestrator",
  "input": {
    "task": "ejecutar funcion principal segun spec del agente"
  },
  "expected": {
    "behavior": "segun descriptor agent.dev-orchestrator",
    "laws_linked": true,
    "human_gate_respected": true
  },
  "assertions": [
    "descriptor existe",
    "laws aplicables enlazadas",
    "enforcement activo"
  ],
  "cases": [
    {
      "id": "golden-inline-strips-frontmatter",
      "input": "inline-prompt de un agente con frontmatter",
      "expected": "solo el cuerpo del prompt, sin claves de frontmatter",
      "aggregate": {
        "script": "scripts/savia-orchestrator-helper.sh",
        "cwd": "{dir}",
        "args": [
          "inline-prompt",
          "demo"
        ],
        "env": {
          "PROJECT_ROOT": "{dir}",
          "AGENTS_DIR": "{dir}/agents"
        },
        "files": {
          "agents/demo.md": "---\nname: demo\nmodel_tier: mid\npermission_level: L1\n---\n# Demo\nCuerpo del prompt del agente demo.\n"
        },
        "expect": {
          "exit": 0,
          "stdout_match": [
            "^# Demo$",
            "^Cuerpo del prompt del agente demo\\.$"
          ],
          "stdout_not_match": [
            "model_tier",
            "permission_level",
            "^---$"
          ]
        }
      }
    },
    {
      "id": "golden-mode-fan-out-declared",
      "input": "savia-env.sh declara has-task-fan-out=yes",
      "expected": "fan-out",
      "aggregate": {
        "script": "scripts/savia-orchestrator-helper.sh",
        "cwd": "{dir}",
        "args": [
          "mode"
        ],
        "env": {
          "PROJECT_ROOT": "{dir}",
          "AGENTS_DIR": "{dir}/agents"
        },
        "files": {
          "scripts/savia-env.sh": "[ \"$1\" = has-task-fan-out ] && echo yes\n"
        },
        "expect": {
          "exit": 0,
          "stdout_match": [
            "^fan-out$"
          ]
        }
      }
    }
  ]
}
