{
  "name": "soul-continuity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Soul Continuidad v1 (SE-490): gemelo operativo de solo lectura, por usuario y sin privilegios. TypeScript sobre Node.js LTS, sin dependencias de ejecución.",
  "license": "MIT",
  "engines": { "node": ">=22.6" },
  "bin": { "soul": "bin/soul.mjs" },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts test/adapters/*.test.ts test/api/*.test.mjs bench/test/*.test.ts tests/attention/*.test.ts",
    "test:adapters": "node --experimental-strip-types --no-warnings --test test/adapters/*.test.ts",
    "evals:attention": "node --experimental-strip-types --no-warnings tests/attention/evals.ts",
    "mutants:attention": "node --experimental-strip-types --no-warnings tests/attention/bench/mutaciones.ts",
    "bench": "node --experimental-strip-types --no-warnings bench/src/cli.ts bench --impl src/core/bench-impl.ts",
    "bench:reference": "node --experimental-strip-types --no-warnings bench/src/cli.ts bench",
    "mutants": "node --experimental-strip-types --no-warnings bench/src/cli.ts mutants",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/attention/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p src/web/tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
