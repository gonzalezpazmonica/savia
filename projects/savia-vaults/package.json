{
  "name": "savia-vaults",
  "version": "0.2.0",
  "description": "Context Dome Server — MCP + A2A server for AI agent knowledge vaults with git-backed storage, hybrid search, and content signing",
  "license": "MIT",
  "type": "module",
  "main": "dist/server/index.js",
  "bin": {
    "savia-vaults": "dist/cli/index.js"
  },
  "files": [
    "dist/",
    "workers/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts serve",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "vitest run tests/e2e/",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "bcryptjs": "^3.0.3",
    "commander": "^13.1.0",
    "libsodium-wrappers-sumo": "0.8.4",
    "minisearch": "^7.1.0",
    "simple-git": "^3.27.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/libsodium-wrappers-sumo": "0.8.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "tus-js-client": "4.3.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "mcp",
    "a2a",
    "context-dome",
    "knowledge-vault",
    "ai-agents",
    "git-backed",
    "local-first",
    "savia"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gonzalezpazmonica/savia-vaults"
  },
  "author": "Savia <savia@pm-workspace>",
  "mcp": {
    "server": {
      "command": "savia-vaults",
      "args": [
        "serve",
        "--transport",
        "mcp"
      ]
    }
  },
  "optionalDependencies": {
    "@huggingface/tokenizers": "^0.2.0",
    "onnxruntime-node": "^1.31.1"
  }
}
