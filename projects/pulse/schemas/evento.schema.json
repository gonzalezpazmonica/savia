{
  "title": "Pulse evento de planta (una línea de eventos.jsonl)",
  "type": "object",
  "required": ["schema_version", "id", "tipo", "at", "clase", "entrega", "nivel"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(\\.[0-9]{1,3})?$"},
    "id": {"type": "string", "pattern": "^ev-[0-9a-f]{16}$"},
    "tipo": {"enum": ["job_started", "job_beat", "job_finished", "pr_created", "pr_merged", "aviso_respaldo"]},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "clase": {"enum": ["ninguna", "transitoria", "cuota", "ci_ajena", "ci_atascada", "logica", "entorno", "politica", "desconocida"]},
    "entrega": {"enum": ["ninguna", "pendiente", "soul", "respaldo"]},
    "nivel": {"enum": ["N1", "N2", "N3", "N4", "N4b"]}
  },
  "allOf": [
    {"if": {"properties": {"tipo": {"const": "job_started"}}, "required": ["tipo"]},
     "then": {"required": ["job_id", "intento"],
              "properties": {"job_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                             "intento": {"type": "integer", "minimum": 1, "maximum": 1000},
                             "heartbeat_ttl": {"type": "integer", "minimum": 10, "maximum": 86400},
                             "propuesta": {"type": "string", "pattern": "^[A-Za-z0-9_./#-]{1,64}$"},
                             "modelo": {"type": "string", "pattern": "^[A-Za-z0-9_.:/-]{1,64}$"}}}},
    {"if": {"properties": {"tipo": {"const": "job_beat"}}, "required": ["tipo"]},
     "then": {"required": ["job_id", "seq", "fase"],
              "properties": {"job_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                             "seq": {"type": "integer", "minimum": 1},
                             "fase": {"type": "string", "pattern": "^[A-Za-z0-9 ._:/-]{1,80}$"}}}},
    {"if": {"properties": {"tipo": {"const": "job_finished"}}, "required": ["tipo"]},
     "then": {"required": ["job_id", "intento", "rc", "resultado", "peticion_id"],
              "properties": {"job_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
                             "intento": {"type": "integer", "minimum": 1, "maximum": 1000},
                             "rc": {"type": "integer", "minimum": 0, "maximum": 255},
                             "resultado": {"enum": ["ok", "fallo", "interrumpido"]},
                             "peticion_id": {"type": "string", "pattern": "^aviso-run-[A-Za-z0-9_-]{1,64}-[0-9]{1,4}$"}}}},
    {"if": {"properties": {"tipo": {"enum": ["pr_created", "pr_merged"]}}, "required": ["tipo"]},
     "then": {"required": ["propuesta"],
              "properties": {"propuesta": {"type": "string", "pattern": "^[A-Za-z0-9_./#-]{1,64}$"}}}},
    {"if": {"properties": {"tipo": {"const": "aviso_respaldo"}}, "required": ["tipo"]},
     "then": {"required": ["ref", "texto", "canal_so"],
              "properties": {"ref": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
                             "texto": {"type": "string", "minLength": 1, "maxLength": 300},
                             "canal_so": {"enum": ["ok", "no_disponible"]},
                             "entrega": {"const": "respaldo"}}}}
  ]
}
