{
  "title": "Pulse latido (latido.json)",
  "type": "object",
  "required": ["schema_version", "at", "valid_until", "pasada", "fuentes_vencidas"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(\\.[0-9]{1,3})?$"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "format": "date-time"},
    "valid_until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "format": "date-time"},
    "pasada": {"type": "integer", "minimum": 0},
    "duracion_s": {"type": "number", "minimum": 0, "maximum": 86400},
    "fuentes_vencidas": {"type": "array", "maxItems": 50,
                         "items": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$"}}
  }
}
