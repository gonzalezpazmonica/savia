{
  "title": "Pulse peticiones a la persona (peticiones.json, instantánea de nivel)",
  "type": "object",
  "required": ["schema_version", "at", "peticiones"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(\\.[0-9]{1,3})?$"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "peticiones": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["id", "fuente", "nivel", "critica", "desde", "que", "por_que_ahora", "si_no_contestas", "si_aplazas", "caduca"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
          "fuente": {"enum": ["PR_REVISION", "AVISO_RUN", "PENDIENTE_MANANA"]},
          "nivel": {"enum": ["N1", "N2", "N3", "N4", "N4b"]},
          "critica": {"type": "boolean"},
          "desde": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
          "que": {"type": "string", "minLength": 1, "maxLength": 300},
          "por_que_ahora": {"type": "string", "minLength": 1, "maxLength": 300},
          "si_no_contestas": {"type": "string", "minLength": 1, "maxLength": 300},
          "si_aplazas": {"type": "string", "minLength": 1, "maxLength": 300},
          "caduca": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
        }
      }
    }
  }
}
