{
  "title": "Presencia de Soul (presencia.json, la escribe Soul)",
  "type": "object",
  "required": ["schema_version", "at", "valid_until"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(\\.[0-9]{1,3})?$"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "valid_until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
