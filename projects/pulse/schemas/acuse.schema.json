{
  "title": "Acuse de entrega (una línea de acuses.jsonl, la escribe Soul)",
  "type": "object",
  "required": ["schema_version", "id", "canal", "at"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1(\\.[0-9]{1,3})?$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
    "canal": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,40}$"},
    "at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "format": "date-time"}
  }
}
