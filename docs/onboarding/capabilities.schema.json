{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/gonzalezpazmonica/pm-workspace/docs/onboarding/capabilities.schema.json",
  "title": "SE-484 — catálogo de capacidades del onboarding",
  "description": "Lo valida scripts/onboarding-plan.py validate (subconjunto de draft-07: type, required, properties, additionalProperties, enum, pattern, items, minItems, maxLength).",
  "definitions": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "step": {
      "type": "object",
      "required": ["text", "command"],
      "additionalProperties": false,
      "properties": {"text": {"type": "string"}, "command": {"$ref": "#/definitions/id"}}
    },
    "steps": {"type": "array", "items": {"$ref": "#/definitions/step"}},
    "requirement": {
      "type": "object",
      "required": ["id", "description", "check"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "description": {"type": "string"},
        "check": {
          "type": "object",
          "required": ["type", "value"],
          "additionalProperties": false,
          "properties": {"type": {"type": "string", "enum": ["command", "file"]}, "value": {"type": "string"}}
        }
      }
    },
    "configures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sets": {"type": "object"},
        "commands": {"type": "array", "items": {"$ref": "#/definitions/id"}},
        "skills": {"type": "array", "items": {"$ref": "#/definitions/id"}},
        "packs": {"type": "array", "items": {"type": "string"}},
        "requires": {"type": "array", "items": {"$ref": "#/definitions/requirement"}}
      }
    },
    "option": {
      "type": "object",
      "required": ["id", "label", "description", "configures"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "label": {"type": "string", "maxLength": 40},
        "description": {"type": "string"},
        "featured": {"type": "boolean"},
        "sensitive": {"type": "string"},
        "configures": {"$ref": "#/definitions/configures"},
        "first_steps": {"$ref": "#/definitions/steps"}
      }
    },
    "ask": {
      "type": "object",
      "required": ["id", "header", "question", "multi", "recommended", "options"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/key"},
        "header": {"type": "string", "maxLength": 12},
        "question": {"type": "string"},
        "multi": {"type": "boolean"},
        "recommended": {"$ref": "#/definitions/id"},
        "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/definitions/option"}}
      }
    },
    "capability": {
      "type": "object",
      "required": ["id", "title", "description", "serves", "sensitivity", "configures", "asks"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/definitions/id"},
        "title": {"type": "string"},
        "description": {"type": "string"},
        "always": {"type": "boolean"},
        "serves": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "sensitivity": {
          "type": "object",
          "required": ["level", "special_category"],
          "additionalProperties": false,
          "properties": {
            "level": {"type": "string", "enum": ["N1", "N2", "N3", "N4", "N4b"]},
            "special_category": {"type": "boolean"},
            "why": {"type": "string"}
          }
        },
        "configures": {"$ref": "#/definitions/configures"},
        "asks": {"type": "array", "items": {"$ref": "#/definitions/ask"}},
        "first_steps": {"$ref": "#/definitions/steps"}
      }
    }
  },
  "type": "object",
  "required": ["version", "profile_template", "interview_skill", "vertical_detection", "open_question", "clarify_question", "no_vertical_message", "general_first_steps", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "integer"},
    "profile_template": {"type": "string"},
    "interview_skill": {"$ref": "#/definitions/id"},
    "vertical_detection": {"type": "string"},
    "open_question": {"type": "string"},
    "clarify_question": {"type": "string"},
    "no_vertical_message": {"type": "string"},
    "general_first_steps": {"type": "array", "minItems": 3, "items": {"$ref": "#/definitions/step"}},
    "capabilities": {"type": "array", "minItems": 10, "items": {"$ref": "#/definitions/capability"}}
  }
}
